	)
	(text "Card edge, 2x50 fingers. Pin 2 is rightmost seen from the component side.\nNo series resistors, no buffers: every bus net goes straight to the module."
		(exclude_from_sim no)
		(at 17.74 53.32 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
				(color 30 90 200 1)
			)
			(justify left top)
		)
		(uuid "d45700f9-120f-5b4e-b199-49460379d000")
	)
	(text "Pin 70 (/LDS) is not connected: GPIO18 is the microSD chip select here.\nThe bus PIO programs wait on /AS and branch on READ only. With /UDS alone\nword access, Autoconfig and the rejection of an odd-byte write work;\nan even-byte write is taken as a word write.\nXRDY (18) comes straight from GPIO27 (36 ns /AS to XRDY measured at\n240 MHz). /INT2 (19) or /INT6 (22) through Q1 and JP1.\n+5 V on 5 and 6, pin 91 to GND (Zorro II)."
		(exclude_from_sim no)
		(at 17.78 212.09 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
				(color 70 70 70 1)
			)
			(justify left top)
		)
		(uuid "f74945cf-0425-5560-9b3e-57c2fc5b1e61")
	)
	(text "U1: Waveshare Core2350B B0 (RP2350B module, no PSRAM)"
		(exclude_from_sim no)
		(at 114.26 48.22 0)
		(effects
			(font
				(size 2.8 2.8)
				(bold yes)
				(color 0 140 60 1)
			)
			(justify left top)
		)
		(uuid "63f220b2-1ac9-574e-83d6-cd48032bdc71")
	)
	(text "Four 2x8 pin strips P1-P4 round a 25.4 mm square, drawn here in the order of the GPIO numbers.\nGPIO0-17, 19-43 and 45 as in hardware/PINMAP.md. Different: GPIO18 microSD CS, GPIO44 / 46 / 47 I2S."
		(exclude_from_sim no)
		(at 114.26 53.32 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
				(color 0 140 60 1)
			)
			(justify left top)
		)
		(uuid "38ae5198-4b15-525a-b252-7c15b2f5de57")
	)
