	)
	(text "GPIO45 high asserts the interrupt (push-pull, high = asserted: the drive of firmware feature int-nfet).\nJP1 is bridged 1-2 as delivered: /INT2. Cut 1-2 and bridge 2-3 for /INT6."
		(exclude_from_sim no)
		(at 302.22 53.32 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
